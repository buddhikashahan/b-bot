# Copy to .env and uncomment what you need. Every value is optional.

# --- Web dashboard ---
# PORT=3000
# HOST=0.0.0.0

# Dashboard password. If unset, you choose one in the browser on first visit
# (set it here when the port is reachable by anyone else before you get there).
# DASHBOARD_PASSWORD=

# Secret used to sign login cookies. Generated and stored in data/secret.key if unset.
# APP_SECRET=

# Set to true when B-Bot sits behind a reverse proxy that terminates HTTPS.
# TRUST_PROXY=false

# --- Storage ---
# Where sessions, the SQLite database, media cache, uploads and plugins are kept.
# DATA_DIR=./data

# Database. Leave unset for zero-config SQLite (data/bbot.db), or use one of:
# DATABASE_URL=postgresql://user:password@localhost:5432/bbot
# DATABASE_URL=mysql://user:password@localhost:3306/bbot
# DATABASE_URL=mongodb+srv://user:password@cluster.example.net/bbot
# When unset, the database can also be switched from Dashboard > Settings.

# Where WhatsApp credentials live:
#   file      on disk in data/sessions, mirrored to the database as a backup (default)
#   database  entirely in the database (for hosts without a persistent disk)
# AUTH_STORE=file

# Password for the bundled PostgreSQL (docker compose --profile postgres). Defaults to "bbot".
# POSTGRES_PASSWORD=

# --- Headless mode (no dashboard; pair in the terminal / container logs) ---
# HEADLESS=false
# Phone number (country code + number, digits only) to pair with a code instead of a QR.
# PAIRING_PHONE=

# --- Media downloads ---
# yt-dlp is installed into data/bin on first use and ffmpeg comes with npm install.
# Set these only to use your own copies.
# YTDLP_PATH=
# FFMPEG_PATH=

# --- Misc ---
# LOG_LEVEL=info
# TZ=UTC
# Pin the WhatsApp Web version if connections are rejected, e.g. 2,3000,1023223821
# WA_VERSION=
